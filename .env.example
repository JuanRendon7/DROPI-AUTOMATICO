# =============================================================================
# Dropi Autonomous Sales Machine — Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA commits el archivo .env al repositorio.
# =============================================================================

# ── Infraestructura ────────────────────────────────────────────────────────────
# REQUIRED | Cadena de conexión a PostgreSQL
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_db
# Desarrollo local (Docker): postgresql+asyncpg://dropi:dropi@localhost:5432/dropi
DATABASE_URL=postgresql+asyncpg://dropi:dropi@localhost:5432/dropi

# REQUIRED | URL de Redis para cola de tareas y estado compartido
# Desarrollo local (Docker): redis://localhost:6379/0
# Producción (Upstash): rediss://default:TOKEN@endpoint.upstash.io:6380
REDIS_URL=redis://localhost:6379/0

# ── Anthropic / Claude ─────────────────────────────────────────────────────────
# REQUIRED | Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OPTIONAL | Modelo a usar (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# ── Meta (Facebook / Instagram Ads) ───────────────────────────────────────────
# REQUIRED | Token de acceso de larga duración (nunca caduca)
# Obtener en: Meta Business Suite → Configuración → Tokens de acceso
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED | ID de cuenta publicitaria (formato: act_XXXXXXXXXX)
# Obtener en: Meta Ads Manager → URL del navegador
META_AD_ACCOUNT_ID=act_1234567890

# REQUIRED | Facebook Page ID para crear creativos de anuncios
# Obtener en: facebook.com/{tu_pagina}/about → ID de la página
META_PAGE_ID=1234567890123456

# OPTIONAL | App ID de Meta (para renovar tokens)
META_APP_ID=

# OPTIONAL | App Secret de Meta
META_APP_SECRET=

# OPTIONAL | Presupuesto diario por plataforma de ads en USD (default: 10)
CAMPAIGN_DAILY_BUDGET_USD=10

# ── TikTok Ads ─────────────────────────────────────────────────────────────────
# REQUIRED | Access token de TikTok Marketing API
# Obtener en: https://ads.tiktok.com/marketing_api/apps/
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED | ID del anunciante de TikTok
TIKTOK_ADVERTISER_ID=1234567890123456789

# OPTIONAL | App ID de TikTok
TIKTOK_APP_ID=

# ── Google Ads ─────────────────────────────────────────────────────────────────
# REQUIRED | Developer token de Google Ads
# Obtener en: Google Ads → Herramientas → Centro de la API
GOOGLE_ADS_DEVELOPER_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OPTIONAL | OAuth2 credentials (necesarios para operaciones avanzadas)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# OPTIONAL | ID de cliente de Google Ads (sin guiones)
GOOGLE_ADS_CUSTOMER_ID=

# ── Dropi ──────────────────────────────────────────────────────────────────────
# REQUIRED | Email de tu cuenta en Dropi
DROPI_EMAIL=tu@email.com

# REQUIRED | Contraseña de tu cuenta en Dropi
DROPI_PASSWORD=tu_contraseña_dropi

# OPTIONAL | URL base de Dropi (default: https://app.dropi.co)
DROPI_BASE_URL=https://app.dropi.co

# OPTIONAL | URL de la API REST de Dropi (default: https://api.dropi.co)
DROPI_API_URL=https://api.dropi.co

# OPTIONAL | Integration Key de Dropi REST API
# Obtener en: Dropi → Configuración → Integraciones → Generar clave
# Si no está configurada, el sync de órdenes usará solo Playwright
DROPI_INTEGRATION_KEY=

# OPTIONAL | Modo headless de Playwright (true = sin ventana, recomendado en prod)
PLAYWRIGHT_HEADLESS=true

# OPTIONAL | Directorio para guardar estado de sesión de Playwright
PLAYWRIGHT_STATE_DIR=playwright_state

# ── Research Agent — APIs de tendencias ───────────────────────────────────────
# OPTIONAL | SerpAPI key para Amazon Best Sellers y Google Shopping
# Plan Developer: $75/mes → https://serpapi.com
# Sin esta key, la fuente Amazon queda desactivada automáticamente
SERPAPI_KEY=

# OPTIONAL | Reddit API para señales de demanda desde r/dropshipping
# Crear app en: https://www.reddit.com/prefs/apps → "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=dropi-sales-machine/1.0

# OPTIONAL | TTL en horas del caché Redis para resultados de research (default: 6)
RESEARCH_CACHE_TTL_HOURS=6

# ── Notificaciones (Telegram) ──────────────────────────────────────────────────
# OPTIONAL | Token del bot de Telegram para alertas
# Crear bot en: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# OPTIONAL | Chat ID donde enviar alertas (tu ID o el de un grupo)
TELEGRAM_CHAT_ID=

# ── Aplicación ─────────────────────────────────────────────────────────────────
# OPTIONAL | Entorno (development | production | test)
ENVIRONMENT=development

# OPTIONAL | Nivel de logs (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
